    <property name="styleSheet">
     <string notr="true">QWidget#oknoGP, QWidget#oknoZV, QWidget#oknoPresets {
    background-color: #1e1e1e;
    
    /* Убираем саму линию рамки */
    border: none; 
    
    /* Радиусы оставляем — они будут обрезать фон, а не рамку */
