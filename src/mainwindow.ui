     <property name="styleSheet">
      <string notr="true">/* Обычное состояние */
QPushButton#btnAltV {
    background-color: #2c3e50;
    color: white;
    border: 2px solid transparent;
    border-radius: 15px; /* Закругление */
    padding: 5px;
}

/* При наведении */
QPushButton#btnAltV:hover {
    border: 2px solid #2ecc71; 
    background-color: rgba(46, 204, 113, 0.1); 
    color: #2ecc71;
    border-radius: 15px; /* Должно совпадать с обычным состоянием */
    outline: none;
}</string>
