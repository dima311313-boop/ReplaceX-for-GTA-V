     <string notr="true">/* Вставлять в styleSheet для oknoGta5V */
#oknoGta5V {
    background-color: #2b2b2b; /* Твой цвет фона */
    border-radius: 15px;       /* Радиус закругления */
    border: 1px solid #3f3f3f; /* Тонкая рамка, чтобы окно не сливалось с блюром */
}
</string>
    </property>
    <property name="frameShape">
