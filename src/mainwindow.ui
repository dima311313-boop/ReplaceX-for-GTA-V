     <property name="styleSheet">
      <string notr="true">QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #f5a9b8, stop:1 #d473a0);
    color: white;
    border: none;
    border-radius: 20px;  /* Чем больше — тем круглее, подгони под свой размер кнопки */
    padding: 8px 20px;
    min-width: 80px;
    min-height: 30px;
    font-weight: bold;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #f8b8c4, stop:1 #e080b0);
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #e090a5, stop:1 #c06090);
}</string>
