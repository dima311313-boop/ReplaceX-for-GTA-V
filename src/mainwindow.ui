       <height>201</height>
      </rect>
     </property>
     <property name="styleSheet">
      <string notr="true">/* Вставлять в styleSheet для listView_6 */
QListView#listView_6 {
    background-color: #1e1e1e;
    border-radius: 10px;       /* Чуть меньше, чем у основного окна */
    border: none;
    outline: none;             /* Убирает пунктирную рамку при фокусе */
    background-color: #1e1e1e; /* Темный цвет фона */
    border: 1px solid white;   /* Белая обводка толщиной 1 пиксель */
    color: white;              /* Убедимся, что текст внутри тоже белый */
    padding: 5px;              /* Небольшой отступ внутри рамки */
}

/* Обязательно закругляем внутреннюю часть, чтобы контент не перекрывал углы */
QListView#listView_6 QWidget {
    border-radius: 10px;
}
</string>
     </property>
    </widget>
